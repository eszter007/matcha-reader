# Manifest for src/components/icons/readerDockIcons.h — regenerate with:
#   python3 scripts/convert_icon.py --manifest src/components/icons/readerDockIcons.manifest \
#     --svgdir assets/icons/tabler --size 24 --out src/components/icons/readerDockIcons.h --upright
# then ./bin/clang-format-fix -g. Needs cairosvg and Pillow. Upright: drawn as FreeInkUI bitmaps.
#
# Tabler icons (MIT), vendored in assets/icons/tabler/ from
# https://github.com/tabler/tabler-icons. The toolbar reader menu: the chapter steps either side of
# the progress track, the bookmark toggle beside the page number and the size steps. Its tools are
# larger, in readerDockToolIcons.manifest.
DockPrevChapterIcon = chevron-left-pipe
DockNextChapterIcon = chevron-right-pipe
DockBookmarkIcon = bookmark
DockBookmarkFilledIcon = bookmark-filled
DockSmallerIcon = letter-a-small
DockLargerIcon = letter-a
