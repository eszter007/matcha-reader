# Manifest for src/components/icons/dictionaryIcons.h — regenerate with:
#   python3 scripts/convert_icon.py --manifest src/components/icons/dictionaryIcons.manifest \
#     --svgdir assets/icons/tabler --size 24 --out src/components/icons/dictionaryIcons.h
# then ./bin/clang-format-fix -g. Needs cairosvg and Pillow.
#
# Tabler icons (MIT), vendored in assets/icons/tabler/ from
# https://github.com/tabler/tabler-icons. The dictionary panel's corner button on touch boards:
# saves the looked-up word and its sentence for sentence mining.
DictAddCardIcon = category-plus
